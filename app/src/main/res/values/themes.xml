<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      只用一个「空壳」XML 主题：界面全部由 C + LVGL 画，这里只管窗口背景与
      系统栏的颜色。父主题用框架自带的 Theme.Material.NoActionBar（API 21 起就有，
      minSdk 现在降到 24，仍然一定有）；下面用到的 windowLightStatusBar 是 API 23 起的，
      同样在 24 上可用，所以这个主题**不需要任何版本守卫**。
    -->
    <style name="Theme.FunctionDrawer" parent="@android:style/Theme.Material.NoActionBar">
        <!-- 表是圆屏 + AMOLED，纯黑底最省电也最不刺眼 -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
